# MongoDB connection string
# For local MongoDB installation:
MONGODB_URI=mongodb://localhost:27017/notesapp

# For MongoDB Atlas (replace with your actual connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/notesapp?retryWrites=true&w=majority

# JWT secret for token signing (replace with a strong, random string)
JWT_SECRET=your_super_secret_jwt_key_here_please_change_this_in_production

# Server port (optional, defaults to 5000)
PORT=5000